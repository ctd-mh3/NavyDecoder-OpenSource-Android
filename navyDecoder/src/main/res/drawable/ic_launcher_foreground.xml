<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — navy radar theme.
  Viewport: 108×108dp (adaptive icon spec).
  Safe zone: 18–90 on each axis (center 72×72dp guaranteed visible).
  All content is within the safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer radar ring (white) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M19,54 a35,35 0 1,0 70,0 a35,35 0 1,0 -70,0"/>

    <!-- Middle ring (navy accent blue) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#5B9BD5"
        android:strokeWidth="1.5"
        android:pathData="M30,54 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0"/>

    <!-- Inner ring (navy accent blue) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#5B9BD5"
        android:strokeWidth="1"
        android:pathData="M41,54 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"/>

    <!-- Radar sweep arm pointing NE toward echo blip (60% white) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#99FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M54,54 L79,29"/>

    <!-- Center pivot dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52,54 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"/>

    <!-- Echo blip on middle ring at 45° NE (accent blue) -->
    <path
        android:fillColor="#5B9BD5"
        android:pathData="M68,37 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"/>

    <!-- Letter N (x 37–50, centered in safe zone with D) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M37,65 L37,43 L50,65 L50,43"/>

    <!-- Letter D (x 58–71, 8-unit gap from N endpoint) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M58,43 L58,65 Q71,65 71,54 Q71,43 58,43"/>

</vector>
